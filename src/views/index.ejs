<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://cdn.loom.com; img-src 'self' data: blob: https://loom.com https://*.loom.com https://loomlocal.com https://*.loomlocal.com https://cdn.loom.com; connect-src 'self' https://loom.com https://*.loom.com https://loomlocal.com https://*.loomlocal.com https://cdn.loom.com; frame-src https://loom.com https://*.loom.com https://loomlocal.com https://*.loomlocal.com; media-src blob: data: https://loom.com https://*.loom.com https://cdn.loom.com; worker-src 'self' blob:; font-src 'self' data: https://cdn.loom.com;"
    />
    <title>CaptureDesk</title>
    <style>
      /* ── Reset & Custom Properties ──────────────────────────────── */
      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

      :root {
        --bg-deep: #060a13;
        --bg-surface: rgba(255,255,255,0.04);
        --bg-surface-hover: rgba(255,255,255,0.08);
        --bg-glass: rgba(15,23,42,0.6);
        --accent: #6366f1;
        --accent-glow: rgba(99,102,241,0.35);
        --red: #ef4444;
        --red-glow: rgba(239,68,68,0.3);
        --green: #22c55e;
        --text-primary: #f1f5f9;
        --text-secondary: #94a3b8;
        --text-muted: #64748b;
        --border: rgba(255,255,255,0.08);
        --titlebar-h: 38px;
      }

      html, body {
        height: 100%;
        overflow: hidden;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        color: var(--text-primary);
        background: var(--bg-deep);
      }

      body { display: flex; flex-direction: column; }

      /* ── Animated background ────────────────────────────────────── */
      .bg-canvas {
        position: fixed; inset: 0; z-index: 0; overflow: hidden;
        background: linear-gradient(145deg, #060a13 0%, #0f172a 40%, #0c1222 100%);
      }

      .bg-orb {
        position: absolute; border-radius: 50%;
        filter: blur(90px); opacity: 0.3;
        animation: orb-float 20s ease-in-out infinite;
        will-change: transform;
      }
      .bg-orb:nth-child(1) {
        width: 420px; height: 420px; background: #6366f1;
        top: -120px; left: -100px;
      }
      .bg-orb:nth-child(2) {
        width: 320px; height: 320px; background: #8b5cf6;
        bottom: -60px; right: -80px;
        animation-delay: -7s; animation-duration: 25s;
      }
      .bg-orb:nth-child(3) {
        width: 220px; height: 220px; background: #ec4899;
        top: 45%; left: 55%;
        animation-delay: -13s; animation-duration: 30s;
      }

      @keyframes orb-float {
        0%, 100% { transform: translate(0, 0) scale(1); }
        25%      { transform: translate(30px, -40px) scale(1.05); }
        50%      { transform: translate(-20px, 20px) scale(0.95); }
        75%      { transform: translate(15px, 30px) scale(1.02); }
      }

      /* ── Custom title bar ───────────────────────────────────────── */
      .titlebar {
        position: relative; z-index: 10;
        height: var(--titlebar-h);
        display: flex; align-items: center; justify-content: space-between;
        padding: 0 12px;
        -webkit-app-region: drag;
        user-select: none; flex-shrink: 0;
        border-bottom: 1px solid var(--border);
      }

      .titlebar-brand {
        display: flex; align-items: center; gap: 8px;
      }
      .titlebar-icon { width: 18px; height: 18px; border-radius: 4px; }
      .titlebar-title {
        font-size: 12px; font-weight: 600;
        color: var(--text-secondary); letter-spacing: 0.02em;
      }

      .titlebar-controls {
        display: flex; gap: 2px;
        -webkit-app-region: no-drag;
      }
      .titlebar-btn {
        width: 36px; height: 28px; border: none; background: transparent;
        color: var(--text-muted); cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        border-radius: 6px; transition: background 0.15s, color 0.15s;
      }
      .titlebar-btn:hover { background: var(--bg-surface-hover); color: var(--text-primary); }
      .titlebar-btn.close:hover { background: var(--red); color: white; }
      .titlebar-btn svg { pointer-events: none; }

      /* ── Main content ───────────────────────────────────────────── */
      main {
        position: relative; z-index: 1; flex: 1;
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        padding: 0 32px 20px; gap: 18px;
        /* The layout is sized to fit the default window; auto rather than
           hidden so nothing becomes unreachable if a label wraps. */
        overflow-y: auto;
      }

      /* ── Hero ────────────────────────────────────────────────────── */
      .hero {
        display: flex; flex-direction: column; align-items: center; gap: 10px;
      }

      .logo {
        width: 60px; height: 60px; border-radius: 16px;
        filter: drop-shadow(0 0 24px var(--accent-glow));
        transition: filter 0.4s, transform 0.4s;
      }
      .logo:hover {
        filter: drop-shadow(0 0 40px var(--accent-glow));
        transform: scale(1.06);
      }

      .hero h1 {
        font-size: 28px; font-weight: 700; letter-spacing: -0.02em;
        background: linear-gradient(135deg, #f1f5f9 30%, #94a3b8);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      }

      .tagline {
        font-size: 14px; color: var(--text-muted); font-weight: 400;
      }

      /* ── Record button ──────────────────────────────────────────── */
      .record-section {
        display: flex; flex-direction: column; align-items: center; gap: 14px;
      }

      /* Two columns so the settings stay inside the window height. A row with
         an odd position spans both columns rather than leaving a gap. */
      .settings-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        width: 100%;
        max-width: 720px;
      }

      .settings-grid > .monitor-config:last-child:nth-child(odd) {
        grid-column: 1 / -1;
      }

      .monitor-config {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 9px 12px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.03);
      }

      .monitor-config label {
        font-size: 12px;
        color: var(--text-secondary);
        cursor: pointer;
        user-select: none;
      }

      .monitor-config input[type="checkbox"] {
        cursor: pointer;
        accent-color: var(--accent);
        width: 15px;
        height: 15px;
        flex-shrink: 0;
      }

      .settings-btn {
        background: rgba(15, 23, 42, 0.85);
        color: var(--text-primary);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 12px;
        cursor: pointer;
      }
      .settings-btn:hover { background: var(--bg-surface-hover); }

      .monitor-select {
        min-width: 0;
        flex: 1;
        max-width: 240px;
        background: rgba(15, 23, 42, 0.85);
        color: var(--text-primary);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 6px 10px;
        font-size: 12px;
        outline: none;
        cursor: pointer;
      }

      .monitor-select:focus {
        border-color: rgba(99, 102, 241, 0.55);
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
      }

      .record-container {
        position: relative; width: 60px; height: 60px; margin-top: 10px; margin-bottom: 18px;
      }

      .record-pulse {
        position: absolute; inset: -10px; border-radius: 50%;
        border: 2px solid var(--red); opacity: 0; pointer-events: none;
      }
      .record-container.ready .record-pulse {
        animation: pulse-ring 2.5s ease-out infinite;
      }
      .record-container.ready .record-pulse:nth-child(2) {
        animation-delay: 0.8s;
      }

      @keyframes pulse-ring {
        0%   { transform: scale(0.9); opacity: 0.5; }
        100% { transform: scale(1.6); opacity: 0; }
      }

      #record-button {
        width: 60px; height: 60px; border-radius: 50%; border: none;
        background: radial-gradient(circle at 40% 35%, #f87171, #ef4444 50%, #dc2626);
        box-shadow: 0 0 30px var(--red-glow), inset 0 2px 4px rgba(255,255,255,0.2);
        cursor: pointer; position: relative; z-index: 1;
        transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.3s, opacity 0.3s;
        display: flex; align-items: center; justify-content: center;
      }
      #record-button:hover:not(:disabled) {
        transform: scale(1.08);
        box-shadow: 0 0 50px rgba(239,68,68,0.5), inset 0 2px 4px rgba(255,255,255,0.2);
      }
      #record-button:active:not(:disabled) { transform: scale(0.96); }
      #record-button:disabled {
        opacity: 0.35; cursor: not-allowed;
        box-shadow: 0 0 10px rgba(239,68,68,0.1);
      }

      .record-icon {
        width: 32px; height: 32px; fill: white;
        filter: drop-shadow(0 1px 3px rgba(0,0,0,0.3));
      }

      /* ── Status badge ───────────────────────────────────────────── */
      .status-badge {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 8px 18px;
        background: var(--bg-glass); border: 1px solid var(--border);
        border-radius: 20px; backdrop-filter: blur(16px);
        transition: border-color 0.3s;
      }
      .status-badge.ready { border-color: rgba(34,197,94,0.25); }
      .status-badge.error { border-color: rgba(239,68,68,0.25); }

      .status-dot {
        width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
        background: var(--text-muted); transition: background 0.3s, box-shadow 0.3s;
      }
      .status-badge.loading .status-dot {
        background: var(--accent); animation: blink 1.4s ease-in-out infinite;
      }
      .status-badge.ready .status-dot {
        background: var(--green); box-shadow: 0 0 8px rgba(34,197,94,0.5);
      }
      .status-badge.error .status-dot {
        background: var(--red); box-shadow: 0 0 8px rgba(239,68,68,0.5);
      }

      @keyframes blink {
        0%, 100% { opacity: 1; }
        50%      { opacity: 0.3; }
      }

      #status {
        font-size: 13px; color: var(--text-secondary); white-space: nowrap;
      }

      /* ── Keyboard shortcuts ─────────────────────────────────────── */
      .shortcuts {
        display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; flex-direction: column;
      }
      .shortcut {
        display: flex; align-items: center; gap: 6px;
        font-size: 12px; color: var(--text-muted);
      }

      kbd {
        display: inline-block; padding: 2px 7px;
        background: var(--bg-surface); border: 1px solid var(--border);
        border-radius: 5px; font-family: inherit; font-size: 11px;
        line-height: 1.5; color: var(--text-secondary);
      }

      /* ── Console ────────────────────────────────────────────────── */
      .console-section {
        width: 100%; max-width: 560px;
      }

      .console-toggle {
        display: flex; align-items: center; gap: 6px;
        background: none; border: none; color: var(--text-muted);
        font-size: 12px; font-family: inherit; cursor: pointer;
        padding: 6px 0; transition: color 0.15s;
      }
      .console-toggle:hover { color: var(--text-secondary); }

      .console-chevron {
        display: inline-block; font-size: 10px;
        transition: transform 0.25s;
      }
      .console-chevron.open { transform: rotate(90deg); }

      #debug-log {
        background: rgba(0,0,0,0.25);
        border: 1px solid var(--border); border-radius: 8px;
        max-height: 0; overflow: hidden; padding: 0 16px;
        white-space: pre-wrap;
        font-family: 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;
        font-size: 11px; color: var(--text-muted); line-height: 1.7;
        transition: max-height 0.35s ease, padding 0.35s ease, border-color 0.35s;
      }
      #debug-log.open {
        max-height: 200px; padding: 12px 16px;
        overflow-y: auto; border-color: rgba(255,255,255,0.12);
      }

      /* ── Scrollbar ──────────────────────────────────────────────── */
      ::-webkit-scrollbar { width: 6px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.12); border-radius: 3px; }
      ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }
    </style>
  </head>
  <body>
    <!-- Animated background -->
    <div class="bg-canvas">
      <div class="bg-orb"></div>
      <div class="bg-orb"></div>
      <div class="bg-orb"></div>
    </div>

    <!-- Custom title bar -->
    <div class="titlebar">
      <div class="titlebar-brand">
        <img src="/assets/capturedesk.svg" class="titlebar-icon" alt="" />
        <span class="titlebar-title">CaptureDesk</span>
      </div>
      <div class="titlebar-controls">
        <button class="titlebar-btn" id="btn-minimize" title="Minimize">
          <svg width="12" height="12" viewBox="0 0 12 12"><line x1="2" y1="6" x2="10" y2="6" stroke="currentColor" stroke-width="1.2"/></svg>
        </button>
        <button class="titlebar-btn" id="btn-maximize" title="Maximize">
          <svg width="12" height="12" viewBox="0 0 12 12"><rect x="2" y="2" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.2" fill="none"/></svg>
        </button>
        <button class="titlebar-btn close" id="btn-close" title="Close">
          <svg width="12" height="12" viewBox="0 0 12 12"><line x1="2.5" y1="2.5" x2="9.5" y2="9.5" stroke="currentColor" stroke-width="1.2"/><line x1="9.5" y1="2.5" x2="2.5" y2="9.5" stroke="currentColor" stroke-width="1.2"/></svg>
        </button>
      </div>
    </div>

    <!-- Main content -->
    <main>
      <div class="hero">
        <img src="/assets/capturedesk.svg" class="logo" alt="CaptureDesk" />
        <h1>CaptureDesk</h1>
        <p class="tagline">Unofficial Linux client for Loom</p>
      </div>

      <div class="record-section">
        <div class="settings-grid">
        <div class="monitor-config">
          <label for="monitor-select">UI-Monitor</label>
          <select id="monitor-select" class="monitor-select" title="Monitor für Kamera und Controls"></select>
        </div>
        <div class="monitor-config">
          <label for="desktop-audio-toggle">Desktop-Ton aufnehmen</label>
          <input type="checkbox" id="desktop-audio-toggle" title="System-Audio in die Aufnahme einschließen" />
        </div>
        <div class="monitor-config">
          <label for="capture-quality-select">Aufnahme-Qualität</label>
          <select id="capture-quality-select" class="monitor-select" title="Höher = größere Datei, langsamerer Upload">
            <option value="fast">Schnell (Passthrough)</option>
            <option value="balanced">Ausgewogen (1080p)</option>
            <option value="quality">Qualität (nativ)</option>
          </select>
        </div>

        <div class="monitor-config">
          <label for="camera-size-select">Kameragröße</label>
          <select id="camera-size-select" class="monitor-select" title="Scrollen auf der Kamera ändert die Größe ebenfalls">
            <option value="140">Klein (140 px)</option>
            <option value="200">Mittel (200 px)</option>
            <option value="280">Groß (280 px)</option>
          </select>
        </div>
        <div class="monitor-config">
          <label for="background-blur-toggle">Hintergrund verwischen</label>
          <input type="checkbox" id="background-blur-toggle" title="Kamerahintergrund unscharf machen" />
        </div>
        <div class="monitor-config">
          <label for="loom-app-id-btn">Loom App-ID</label>
          <button type="button" id="loom-app-id-btn" class="settings-btn" title="App-ID der Loom-Developer-App ändern">Ändern…</button>
        </div>
        </div>

        <div class="record-container" id="record-container">
          <div class="record-pulse"></div>
          <div class="record-pulse"></div>
          <button id="record-button" disabled>
            <svg class="record-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/></svg>
          </button>
        </div>
        <div class="status-badge loading" id="status-badge">
          <span class="status-dot"></span>
          <span id="status">Loading Loom…</span>
        </div>
      </div>

      <div class="console-section">
        <button class="console-toggle" id="console-toggle">
          <span class="console-chevron" id="console-chevron">▸</span>
          <span>Console</span>
        </button>
        <pre id="debug-log" aria-live="polite"></pre>
      </div>
    </main>

    <script defer src="/assets/loom-sdk-browser.js"></script>
    <script defer src="/assets/renderer.js"></script>
  </body>
</html>
