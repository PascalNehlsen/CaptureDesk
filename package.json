{
  "name": "capturedesk",
  "version": "1.0.0",
  "description": "CaptureDesk desktop recorder built with Electron",
  "main": "electron-main.js",
  "license": "MIT",
  "scripts": {
    "start": "nodemon -w src src/server/index.js",
    "electron": "npm run vendor:sync && bash ./scripts/launch-desktop.sh",
    "electron:no-sandbox": "npm run vendor:sync && ELECTRON_NO_SANDBOX=1 bash ./scripts/launch-desktop.sh",
    "desktop:install": "bash ./scripts/install-desktop-entry.sh",
    "pack": "npm run vendor:sync && electron-builder --dir",
    "dist": "npm run vendor:sync && electron-builder --linux AppImage",
    "dist:deb": "npm run vendor:sync && electron-builder --linux deb",
    "vendor:sync": "bash ./scripts/sync-vendor-assets.sh"
  },
  "dependencies": {
    "@loomhq/loom-embed": "^1.7.0",
    "@loomhq/record-sdk": "^4.10.4",
    "@mediapipe/tasks-vision": "^1.0.1",
    "dotenv": "^18.0.3",
    "ejs": "6.0.1",
    "express": "5.2.1"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.14"
  },
  "keywords": [],
  "build": {
    "appId": "com.capturedesk.app",
    "productName": "CaptureDesk",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/capturedesk.svg",
      "executableName": "capturedesk",
      "synopsis": "Screen recorder with drawing overlay",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "afterPack": "scripts/after-pack.js"
  },
  "author": {
    "name": "Pascal Nehlsen",
    "email": "mail@pascal-nehlsen.de"
  },
  "homepage": "https://github.com/PascalNehlsen/CaptureDesk",
  "desktopName": "capturedesk.desktop"
}
